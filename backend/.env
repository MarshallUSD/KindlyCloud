# Local development database (Docker: kindlycloud-db, port 5436)
DATABASE_URL=postgresql://kindergarten:kindlycloud@localhost:5436/kindlycloud

# Debug mode
DEBUG=true

# JWT
SECRET_KEY=kindlycloud-local-dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://localhost:5173"]

# Telegram bot parent submissions integration
TELEGRAM_PARENT_SUBMISSIONS_SECRET=local-dev-secret
